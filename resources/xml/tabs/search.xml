<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="24"
    paddingLeft="42"
    paddingRight="42">

    <brls:Label text="@i18n/app/search" fontSize="40" textColor="#F5F7FC" marginBottom="6" />
    <brls:Label text="@i18n/search/prompt" fontSize="16" textColor="#96A5BD" marginBottom="20" />

    <brls:Label
        id="search/status"
        width="auto"
        height="auto"
        text="@i18n/search/prompt"
        fontSize="17"
        textColor="#BDC7D9"
        marginBottom="12" />

    <brls:ProgressSpinner
        id="search/spinner"
        width="auto"
        height="80"
        visibility="gone" />

    <brls:ScrollingFrame scrollingBehavior="centered"
        id="search/scroll"
        width="auto"
        grow="1.0">

        <brls:Box
            id="search/grid"
            width="auto"
            height="auto"
            axis="column" />

    </brls:ScrollingFrame>

</brls:Box>
