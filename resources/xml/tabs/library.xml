<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="24"
    paddingLeft="42"
    paddingRight="42">

    <brls:Label text="@i18n/app/library" fontSize="40" textColor="#F5F7FC" marginBottom="6" />
    <brls:Label text="@i18n/library/controls" fontSize="16" textColor="#96A5BD" marginBottom="20" />

    <brls:Label
        id="library/status"
        width="auto"
        height="auto"
        text="@i18n/app/library"
        fontSize="17"
        textColor="#BDC7D9"
        marginBottom="8" />

    <brls:Label
        id="library/body"
        width="auto"
        height="auto"
        lineHeight="1.55"
        text="@i18n/library/controls"
        fontSize="18"
        textColor="#96A5BD"
        marginBottom="12" />

    <brls:ProgressSpinner
        id="library/spinner"
        width="auto"
        height="80"
        visibility="gone" />

    <brls:ScrollingFrame scrollingBehavior="centered"
        id="library/scroll"
        width="auto"
        grow="1.0">

        <brls:Box
            id="library/grid"
            width="auto"
            height="auto"
            axis="column" />

    </brls:ScrollingFrame>

</brls:Box>
