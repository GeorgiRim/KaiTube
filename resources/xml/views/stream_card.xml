<brls:Box
    width="31.5%"
    height="auto"
    axis="column"
    marginRight="14"
    paddingLeft="8"
    paddingRight="8"
    paddingTop="10"
    paddingBottom="14"
    focusable="true"
    cornerRadius="12"
    backgroundColor="#101621">

    <brls:Image
        id="stream/thumbnail"
        width="auto"
        height="144"
        scalingType="fit"
        cornerRadius="8"
        marginBottom="10" />

    <brls:Label
        id="stream/title"
        width="auto"
        height="auto"
        fontSize="17"
        textColor="#FFFFFF" />

    <brls:Label
        id="stream/channel"
        width="auto"
        height="auto"
        fontSize="14"
        textColor="#BDC7D9"
        marginTop="3" />

    <brls:Box width="auto" height="auto" axis="row" marginTop="2" justifyContent="spaceBetween">
        <brls:Label
            id="stream/left_meta"
            width="auto"
            height="auto"
            fontSize="12"
            textColor="#8593AB" />

        <brls:Label
            id="stream/right_meta"
            width="auto"
            height="auto"
            fontSize="12"
            textColor="#8593AB" />
    </brls:Box>

</brls:Box>
